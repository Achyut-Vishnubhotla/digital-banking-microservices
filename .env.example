# Copy to .env  (cp .env.example .env) and change the values
POSTGRES_USER=bank
POSTGRES_PASSWORD=change-me
# HS256 needs at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# GitHub OAuth App (optional; without it only username/password login works). See README, section OAuth2.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
